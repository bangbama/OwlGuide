# Gemini API Key (required for real AI analysis, get from https://makersuite.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (optional, defaults to gemini-3.1-pro-preview)
GEMINI_MODEL=gemini-3.1-pro-preview

# Force mock mode even if GEMINI_API_KEY is set (optional, default: false)
# Set to "true" to disable real Gemini calls entirely
OWLGUIDE_USE_MOCK_ONLY=false

# Firestore Configuration (optional, for session and event persistence)
# GCP project ID where Firestore is enabled
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# Firestore database ID (optional, defaults to "(default)")
FIRESTORE_DATABASE=(default)

# Enable/disable Firestore writes entirely (optional, default: true)
# Set to "false" to skip all Firestore operations (useful for local development)
OWLGUIDE_FIRESTORE_ENABLED=false
